{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": [
            "node",
            "@playwright/test"
        ]
    },
    "include": [
        "src",
        "tests",
        "playwright.config.ts"
    ]
}